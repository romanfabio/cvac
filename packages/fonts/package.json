{
  "name": "@cvac/fonts",
  "version": "0.0.0",
  "description": "Fonts bundled with CV as Code (SIL Open Font License) and a Node loader.",
  "license": "MIT AND OFL-1.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./faces": {
      "source": "./src/faces.ts",
      "types": "./dist/faces.d.ts",
      "default": "./dist/faces.js"
    },
    "./files/*": "./files/*"
  },
  "files": [
    "dist",
    "files"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
