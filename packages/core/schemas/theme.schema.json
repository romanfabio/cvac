{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "extends": {
      "description": "Theme to inherit from, e.g. 'default'",
      "type": "string"
    },
    "page": {
      "type": "object",
      "properties": {
        "size": {
          "default": "A4",
          "type": "string",
          "enum": [
            "A4",
            "Letter"
          ]
        },
        "margins": {
          "default": "18mm",
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                }
              ]
            },
            {
              "type": "object",
              "properties": {
                "top": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "right": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "bottom": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "left": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                }
              },
              "required": [
                "top",
                "right",
                "bottom",
                "left"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "fonts": {
          "type": "object",
          "properties": {
            "body": {
              "type": "object",
              "properties": {
                "family": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A bundled font family, e.g. Inter"
                },
                "size": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "weight": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "regular"
                    },
                    {
                      "type": "string",
                      "const": "bold"
                    },
                    {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    }
                  ]
                },
                "italic": {
                  "type": "boolean"
                }
              },
              "required": [
                "family"
              ],
              "additionalProperties": false
            },
            "heading": {
              "description": "Section headings",
              "type": "object",
              "properties": {
                "family": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A bundled font family, e.g. Inter"
                },
                "size": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "weight": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "regular"
                    },
                    {
                      "type": "string",
                      "const": "bold"
                    },
                    {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    }
                  ]
                },
                "italic": {
                  "type": "boolean"
                }
              },
              "required": [
                "family"
              ],
              "additionalProperties": false
            },
            "name": {
              "description": "Your name at the top",
              "type": "object",
              "properties": {
                "family": {
                  "type": "string",
                  "minLength": 1,
                  "description": "A bundled font family, e.g. Inter"
                },
                "size": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "weight": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "regular"
                    },
                    {
                      "type": "string",
                      "const": "bold"
                    },
                    {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    }
                  ]
                },
                "italic": {
                  "type": "boolean"
                }
              },
              "required": [
                "family"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "colors": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            }
          },
          "additionalProperties": false
        },
        "spacing": {
          "type": "object",
          "properties": {
            "section": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                }
              ]
            },
            "item": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                }
              ]
            },
            "line": {
              "description": "Line height multiplier",
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "format": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "enum": [
            "MMM YYYY",
            "MMMM YYYY",
            "MM/YYYY",
            "YYYY"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "cvac theme"
}
