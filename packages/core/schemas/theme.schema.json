{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "extends": {
      "description": "Theme to build on: a built-in (default, compact, classic, modern, sidebar, sidebar-right) or a file like ./base.yaml",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "default",
            "compact",
            "classic",
            "modern",
            "sidebar",
            "sidebar-right"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "page": {
      "type": "object",
      "properties": {
        "size": {
          "description": "Default A4",
          "type": "string",
          "enum": [
            "A4",
            "Letter"
          ]
        },
        "margins": {
          "description": "Default 18mm",
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                }
              ]
            },
            {
              "type": "object",
              "properties": {
                "top": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "right": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "bottom": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "left": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                }
              },
              "required": [
                "top",
                "right",
                "bottom",
                "left"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "type": {
          "description": "Default single",
          "type": "string",
          "enum": [
            "single",
            "sidebar"
          ]
        },
        "side": {
          "description": "Sidebar side (default left)",
          "type": "string",
          "enum": [
            "left",
            "right"
          ]
        },
        "width": {
          "description": "Sidebar width (default 32%)",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?%$"
            },
            {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                }
              ]
            }
          ]
        },
        "gap": {
          "description": "Space between the columns (default 8mm)",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
            }
          ]
        },
        "header": {
          "description": "Header across the page (full, default) or only above the main column",
          "type": "string",
          "enum": [
            "full",
            "main"
          ]
        },
        "sidebar": {
          "description": "Section ids placed in the sidebar",
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "photo": {
      "type": "object",
      "properties": {
        "show": {
          "description": "Default true when the CV has basics.photo",
          "type": "boolean"
        },
        "position": {
          "description": "Default header-right (sidebar layouts: sidebar)",
          "type": "string",
          "enum": [
            "header-right",
            "header-left",
            "sidebar"
          ]
        },
        "size": {
          "description": "Width and height (default 28mm)",
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
            }
          ]
        },
        "shape": {
          "description": "Default circle",
          "type": "string",
          "enum": [
            "square",
            "rounded",
            "circle"
          ]
        }
      },
      "additionalProperties": false
    },
    "header": {
      "type": "object",
      "properties": {
        "align": {
          "description": "Default left",
          "type": "string",
          "enum": [
            "left",
            "center"
          ]
        },
        "nameColor": {
          "description": "Color of your name: the text color (default) or the accent color",
          "type": "string",
          "enum": [
            "text",
            "accent"
          ]
        }
      },
      "additionalProperties": false
    },
    "headings": {
      "type": "object",
      "properties": {
        "rule": {
          "description": "A line under the heading (default), an accent bar before it, or nothing",
          "type": "string",
          "enum": [
            "underline",
            "bar",
            "none"
          ]
        },
        "case": {
          "description": "upper writes headings in capitals (the text itself, so ATS read it as written)",
          "type": "string",
          "enum": [
            "normal",
            "upper"
          ]
        }
      },
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "fonts": {
          "type": "object",
          "properties": {
            "body": {
              "type": "object",
              "properties": {
                "family": {
                  "description": "A bundled font family, e.g. Source Sans 3",
                  "type": "string",
                  "minLength": 1
                },
                "size": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "weight": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "regular"
                    },
                    {
                      "type": "string",
                      "const": "bold"
                    },
                    {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    }
                  ]
                },
                "italic": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "heading": {
              "description": "Section headings",
              "type": "object",
              "properties": {
                "family": {
                  "description": "A bundled font family, e.g. Source Sans 3",
                  "type": "string",
                  "minLength": 1
                },
                "size": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "weight": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "regular"
                    },
                    {
                      "type": "string",
                      "const": "bold"
                    },
                    {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    }
                  ]
                },
                "italic": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "name": {
              "description": "Your name at the top",
              "type": "object",
              "properties": {
                "family": {
                  "description": "A bundled font family, e.g. Source Sans 3",
                  "type": "string",
                  "minLength": 1
                },
                "size": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "string",
                      "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                    }
                  ]
                },
                "weight": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "regular"
                    },
                    {
                      "type": "string",
                      "const": "bold"
                    },
                    {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 900
                    }
                  ]
                },
                "italic": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "colors": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "muted": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "sidebarBackground": {
              "description": "Fill behind the sidebar (sidebar layouts)",
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            }
          },
          "additionalProperties": false
        },
        "spacing": {
          "type": "object",
          "properties": {
            "section": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                }
              ]
            },
            "item": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^\\d+(\\.\\d+)?(pt|mm|cm|in)$"
                }
              ]
            },
            "line": {
              "description": "Line height multiplier",
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "format": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "enum": [
            "MMM YYYY",
            "MMMM YYYY",
            "MM/YYYY",
            "YYYY"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "title": "cvac theme"
}
