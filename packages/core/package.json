{
  "name": "@cvac/core",
  "version": "0.0.0",
  "description": "CV as Code core library: model, parsing, layout and renderers.",
  "license": "MIT",
  "author": "Fabio Roman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanfabio/cvac.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/romanfabio/cvac#readme",
  "bugs": {
    "url": "https://github.com/romanfabio/cvac/issues"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./editor": {
      "source": "./src/editor.ts",
      "types": "./dist/editor.d.ts",
      "default": "./dist/editor.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/generate-schemas.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "docx": "9.15.2",
    "fflate": "0.8.3",
    "fontkit": "2.0.4",
    "linebreak": "2.0.0",
    "pdfkit": "0.20.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
